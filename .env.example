# --- Supabase (leave empty to run in demo mode with seeded in-memory data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Any long random string. Vercel Cron sends it as "Authorization: Bearer <value>".
CRON_SECRET=
# 32 bytes as 64 hex characters (openssl rand -hex 32). Encrypts stored Meta tokens.
TOKEN_ENCRYPTION_KEY=

# --- Meta ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Email (Resend). Sender name/address and mailing address are set per workspace in Settings. ---
RESEND_API_KEY=

# --- Calendar webhook (Cal.com). Optional: the built-in booking page works without it. ---
CAL_WEBHOOK_SECRET=

# --- AI analyst (optional; falls back to the rule-based analysis) ---
ANTHROPIC_API_KEY=
