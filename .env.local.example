# Copy this file to .env.local:   cp .env.local.example .env.local
#
# DEMO MODE: leave everything below blank. With no Supabase keys the app runs
# against seeded in-memory sample data as a built-in demo user (no login, no
# external services). Demo data resets each time the server restarts.
#
# Fill these in only when you are ready to connect real services.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Any long random string (used to protect the scheduled jobs).
CRON_SECRET=
# 64 hex characters: run `openssl rand -hex 32`. Encrypts stored Meta tokens.
TOKEN_ENCRYPTION_KEY=

# --- Supabase (database + login). Setting URL + service role key turns demo mode OFF. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta (Facebook/Instagram ads + lead-form webhook) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Calendar webhook (Cal.com) — optional ---
CAL_WEBHOOK_SECRET=

# --- AI analyst — optional (falls back to rule-based analysis) ---
ANTHROPIC_API_KEY=
